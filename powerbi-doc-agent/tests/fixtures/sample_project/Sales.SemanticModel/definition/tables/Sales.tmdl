table Sales
    lineageTag: sales-table

    measure 'Total Sales' = ```
        SUMX(
            Sales,
            Sales[Quantity] * Sales[UnitPrice]
        )
        ```
        formatString: "$"#,0.00

    column Quantity
        dataType: int64
        sourceColumn: Quantity

    column UnitPrice
        dataType: decimal
        sourceColumn: UnitPrice

    column 'Customer Id'
        dataType: int64
        sourceColumn: CustomerId

    partition Sales = m
        mode: import
        source = ```
            let
                Source = Csv.Document(File.Contents("sales.csv")),
                Promoted = Table.PromoteHeaders(Source)
            in
                Promoted
            ```
